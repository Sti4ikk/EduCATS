<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Cleartext is still allowed: the local server option (http://172.16.11.72)
        and http links opened in web views rely on it.
        Only system CAs are trusted in release builds.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- User-installed CAs (e.g. a debugging proxy) are trusted in debug builds only. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
